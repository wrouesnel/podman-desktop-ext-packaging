Source: podman-desktop-ext
Section: devel
Priority: optional
Maintainer: @MAINTAINER@
# the runtime libraries of Electron: dpkg-shlibdeps maps the libraries the binaries need to their packages
Build-Depends: debhelper-compat (= 13),
 libgtk-3-0t64, libnss3, libasound2t64, libgbm1, libxkbcommon0, libxcomposite1, libxdamage1,
 libxrandr2, libxext6, libxfixes3, libexpat1, libdrm2, libcups2t64, libdbus-1-3, libatspi2.0-0t64
Standards-Version: 4.7.0
Homepage: https://github.com/wrouesnel/podman-desktop-ext
Vcs-Browser: https://github.com/wrouesnel/podman-desktop-ext-packaging
Rules-Requires-Root: no

Package: podman-desktop-ext
Architecture: amd64
Depends: ${shlibs:Depends}, ${misc:Depends}, xdg-utils
Recommends: podman
Description: Manage Podman and other container engines from a single UI (extended build)
 Podman Desktop Ext is an extended build of Podman Desktop, an open source
 graphical tool to work with containers and Kubernetes from your local
 environment. It adds a tabbed and split pod terminal, a file browser for
 PersistentVolumeClaims, an editor for ConfigMap and Secret values, and pages
 for all the Kubernetes resources and custom resources.
 .
 It installs side by side with Podman Desktop, with its own settings and data,
 and its telemetry is disabled.
