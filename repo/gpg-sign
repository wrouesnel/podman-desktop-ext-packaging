#!/bin/bash
# gpg for the signing commands of the repository scripts (also used by rpmsign, as %__gpg).
# When PACKAGE_SIGNING_KEY_PASSPHRASE is set, the passphrase of the key is given to gpg through a pipe
# (loopback pinentry): never in a file, nor on a command line.
set -euo pipefail
# the agent sockets go in the runtime directory of the container, not in the (mounted) keyring
if [ ! -d "/run/user/$(id -u)" ]; then
  mkdir -p -m 700 "/run/user/$(id -u)"
fi
gpgconf --create-socketdir 2>/dev/null || true
if [ -n "${PACKAGE_SIGNING_KEY_PASSPHRASE:-}" ]; then
  exec gpg --batch --pinentry-mode loopback --passphrase-fd 3 "$@" 3< <(printf '%s' "$PACKAGE_SIGNING_KEY_PASSPHRASE")
fi
exec gpg --batch "$@"
