# Repackages the prebuilt Podman Desktop Ext application archive (see scripts/build-app.sh): the source RPM
# carries the archive, built from the sources on GitHub, as the build services (COPR) build offline.
# Generated by scripts/build-srpm.sh from rpm/podman-desktop-ext.spec.in.

%global appdir /opt/podman-desktop-ext
%global app_id io.podman_desktop.PodmanDesktopExt

# prebuilt Electron application: no debuginfo, no stripping, no build-id links (would conflict with other
# Electron applications), no rpath / shebang processing of the bundled files
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __arch_install_post %{nil}
%global __brp_mangle_shebangs %{nil}
%global _build_id_links none

# the libraries bundled with Electron are provided by the application itself
%global __provides_exclude_from ^%{appdir}/.*$
%global __requires_exclude ^(libffmpeg|libEGL|libGLESv2|libvk_swiftshader|libvulkan)\\.so.*$
# the extensions and node modules resources embed binaries and scripts for other platforms / interpreters
%global __requires_exclude_from ^%{appdir}/resources/.*$

Name:           podman-desktop-ext
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Manage Podman and other container engines from a single UI (extended build)
License:        Apache-2.0
URL:            https://github.com/wrouesnel/podman-desktop-ext
Source0:        podman-desktop-ext-@APP_VERSION@-linux-x64.tar.gz
ExclusiveArch:  x86_64

Requires:       hicolor-icon-theme
Requires:       xdg-utils
Recommends:     podman

%description
Podman Desktop Ext is an extended build of Podman Desktop, an open source graphical
tool to work with containers and Kubernetes from your local environment. It adds a
tabbed and split pod terminal, a file browser for PersistentVolumeClaims, an editor
for ConfigMap and Secret values, and pages for all the Kubernetes resources and
custom resources. It installs side by side with Podman Desktop, with its own
settings and data, and its telemetry is disabled.

%prep
%setup -q -n podman-desktop-ext-@APP_VERSION@

%build
# prebuilt

%install
install -d %{buildroot}%{appdir} %{buildroot}%{_bindir}
cp -a app/. %{buildroot}%{appdir}/
ln -s %{appdir}/podman-desktop-ext %{buildroot}%{_bindir}/podman-desktop-ext
cp -a share/. %{buildroot}%{_datadir}/
install -Dm 0644 BUILD_INFO %{buildroot}%{_docdir}/%{name}/BUILD_INFO

%files
%license app/LICENSE.electron.txt
%doc %{_docdir}/%{name}/BUILD_INFO
%{appdir}
# setuid sandbox helper, used when unprivileged user namespaces are not available
%attr(4755, root, root) %{appdir}/chrome-sandbox
%{_bindir}/podman-desktop-ext
%{_datadir}/applications/%{app_id}.desktop
%{_datadir}/metainfo/%{app_id}.metainfo.xml
%{_datadir}/icons/hicolor/scalable/apps/%{app_id}.svg
%{_datadir}/icons/hicolor/512x512/apps/%{app_id}.png
# managed configuration: telemetry disabled and locked (administrators can add their own settings)
%dir %{_datadir}/podman-desktop-ext
%config(noreplace) %{_datadir}/podman-desktop-ext/default-settings.json
%config(noreplace) %{_datadir}/podman-desktop-ext/locked.json

%changelog
* @DATE@ @PACKAGER@ - @VERSION@-@RELEASE@
- Podman Desktop Ext @APP_VERSION@ (@COMMIT@)
